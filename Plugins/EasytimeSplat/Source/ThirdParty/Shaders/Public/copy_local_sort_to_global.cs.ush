[numthreads(THREAD_GROUP_SIZE_X, 1, 1)] void main(
    uint3 group_id : SV_GroupID,
    uint group_index : SV_GroupIndex) {
  // Dispatch may be wrapped onto Y/Z for large splat counts.
  uint local_id =
      GetUnWrappedDispatchThreadId(group_id, group_index, THREAD_GROUP_SIZE_X);
  if (local_id >= num_splats) {
    return;
  }

  uint global_id = global_offset + local_id;
  out_global_indices[global_id] = global_id;
  out_global_distances[global_id] = local_distances[local_id];
}
